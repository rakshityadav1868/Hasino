<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Android App Links: the return leg of Google sign-in.

              Clerk's OAuth is a full redirect, and Google refuses to run it
              inside an embedded WebView, so the browser takes over for the
              Google step. Without this filter the browser also keeps the
              *result*: Chrome lands on https://<host>/sso-callback, completes
              the handshake against Chrome's cookie jar, and the user is signed
              in in Chrome while the app they started from still shows a sign-in
              button. The session cannot cross — a WebView has its own storage.

              autoVerify makes Android check
              https://<host>/.well-known/assetlinks.json for this package and
              signing certificate at install time. Verified, the callback URL
              opens here instead of in the browser, and the WebView — which is
              where the sign-in attempt was created and where Clerk's client
              state lives — is the thing that finishes it. That is why this is
              App Links rather than a custom scheme: the redirect URL has to
              stay a real https URL that Clerk will accept and that works
              unchanged in a desktop browser.

              Scoped to /sso-callback on purpose. Claiming the whole host would
              make every hasino link — a salon someone shared, a page opened
              from an email — hijack the browser into the app.

              The host comes from the Capacitor config via a manifest
              placeholder; see android/app/build.gradle.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="${hasinoAppHost}"
                    android:path="/sso-callback" />
            </intent-filter>

            <!--
              The same callback, by scheme, for when App Links verification did
              not hold: no network at install time, a sideloaded build, a
              device that never rechecked. Android verifies App Links; it does
              not verify schemes, so this route cannot fail the same way — and
              a silent fallback to Chrome is precisely the failure worth
              covering, because the user is then signed in somewhere that is
              not the app they started from.

              Reached only from the callback page itself, which hands the URL
              on when it notices it is in a browser (see handOffToNativeApp in
              app.js). Nothing else uses it.

              A scheme is unowned — any app on the device may claim `hasino://`
              — so nothing is trusted because it arrived here. MainActivity
              takes only the query parameters and puts them back on the origin
              the app is configured for; a hostile sender can therefore make
              this app reload its own callback URL, and nothing else.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hasino" android:host="sso-callback" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!--
      Package visibility, for finding a browser that speaks Custom Tabs.

      Android 11 and later hide every other installed package from an app
      unless it declares what it needs to see. Without this,
      CustomTabsClient.getPackageName() queries for a Custom Tabs service and
      is told there are none, returns null, and the launch falls back to a bare
      ACTION_VIEW — which on a device with no default browser is answered by
      the "Open with" chooser, mid sign-in, offering browsers with no way for
      the user to know which one keeps the flow working. Observed exactly that
      on Android 15. A plain browser picked there is not a Custom Tab at all,
      so the return leg loses the property the whole flow depends on.

      Two entries because they answer two different questions: the service
      intent finds browsers that implement Custom Tabs, and the http intent
      makes ordinary browsers resolvable for the ActivityNotFoundException
      fallback in OAuthTabWebViewClient.
    -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Location, for "Use my current location" in the header.

      Declared only. Android does not grant a dangerous permission because it
      is in the manifest — Capacitor's WebChromeClient asks for it the first
      time the page calls navigator.geolocation, which happens on that tap and
      nowhere else. Nothing requests location at launch.

      COARSE is listed alongside FINE because the app wants a city name, not a
      doorstep: a user who grants only approximate location still gets a
      working salon search, and Android 12+ lets them choose exactly that.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- The app is a shell around a website; it is useless without a network,
         but it does not need GPS hardware to install. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
